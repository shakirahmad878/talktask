# TalkTask Environment Configuration Example
# Copy this file to .env for local configuration.
# Never commit secrets or private API keys to version control.

# Application Information
EXPO_PUBLIC_APP_NAME="TalkTask"
EXPO_PUBLIC_APP_VERSION="1.0.0"

# Optional Cloud Speech / Whisper Transcription Provider
# Leave empty to use 100% offline speech recognition and on-device NLP
EXPO_PUBLIC_WHISPER_API_ENDPOINT=""
EXPO_PUBLIC_WHISPER_API_KEY=""

# Optional AdMob Production IDs (Default uses official Google Test Ad IDs during development)
EXPO_PUBLIC_ADMOB_ANDROID_APP_ID="ca-app-pub-3940256099942544~3347511713"
EXPO_PUBLIC_ADMOB_BANNER_ID="ca-app-pub-3940256099942544/6300978111"
EXPO_PUBLIC_ADMOB_INTERSTITIAL_ID="ca-app-pub-3940256099942544/1033173712"
